# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/cassava
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Admin dashboard: set these for /api/admin/login and protected routes
# Generate a random string for ADMIN_TOKEN (e.g. openssl rand -hex 24)
ADMIN_PASSWORD=your-admin-password
ADMIN_TOKEN=your-admin-bearer-token
